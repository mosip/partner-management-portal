<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<!-- Focused suite: MOSIP-44516 TC_44516_14 Verify Re-Upload with same certificate file.
     Not under testngFile/ (TestRunner loads every file there). Use by temporarily
     replacing testng.xml, or copy into testngFile for a one-off focused run. -->
<suite name="TC_44516_14 Same Certificate Re-Upload" preserve-order="true" parallel="false">

	<test name="TC_44516_14" preserve-order="true">
		<classes>
			<class name="io.mosip.testrig.pmpuiv2.testcase.PartnerAdminCreation" />
			<class name="io.mosip.testrig.pmpuiv2.testcase.CredentialPartnerCertificateTest">
				<methods>
					<include name="registerCredentialPartnerForCertificateFlow" />
					<include name="verifyValidPartnerCertificateUploadIsSuccessful" />
					<include name="verifyReUploadWithSameCertificateFile" />
				</methods>
			</class>
		</classes>
	</test>

	<listeners>
		<listener class-name="io.mosip.testrig.pmpuiv2.utility.EmailableReport" />
		<listener class-name="io.mosip.testrig.pmpuiv2.utility.KnownIssues" />
	</listeners>

</suite>
